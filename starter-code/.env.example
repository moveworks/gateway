# Moveworks Content Gateway — Environment Variables
# ===================================================
# For local development: copy this file to .env and fill in your values.
# Never commit .env to source control.
#
# In production, set these via your platform's secret management:
#   AWS Lambda:      Secrets Manager or Lambda Environment Variables
#   Azure Functions: Key Vault or Application Settings
#   Heroku:          heroku config:set KEY=value

# The API key Moveworks will use to authenticate to YOUR gateway.
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then register this value as the credential in Moveworks Setup.
GATEWAY_API_KEY=

# Your content source system's base URL and credentials.
SOURCE_API_BASE_URL=https://your-system.example.com/api
SOURCE_API_KEY=

# Optional: override the default port (default: 5001)
# PORT=5001

# Optional (demo mode only): inject the running operator's real email as a
# sample user so the demo content surfaces in the AI Assistant when this
# server is connected to a real Moveworks tenant. Comma-separate for multiple.
# Each injected user is granted access to kb-001 through kb-007.
# DEMO_TEST_USER_EMAILS=you@yourcompany.com
